@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<nav class="main-navbar">
    <div class="main-navbar-container">
        <a class="main-navbar-brand" href="/">
            <div class="brand-logo-icon">🌐</div>
            Re<span>Shared</span>
        </a>

        <ul class="main-navbar-links">
            <li class="main-navbar-item">
                <a class="main-navbar-link active" href="/">Home</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link" href="#">Odkrywaj</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link" href="#">Kategorie</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link" href="#">Dla Ciebie</a>
            </li>
            <li class="main-navbar-item">
                <a class="main-navbar-link" href="#">Wiadomości</a>
            </li>
        </ul>

        <div class="navbar-right">
            <form class="navbar-search" role="search">
                <input class="navbar-search-input"
                       type="search"
                       placeholder="Czego szukasz w ETI?"
                       aria-label="Search" />

                <button class="navbar-search-button" type="submit">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </form>

            <AuthorizeView>
                <Authorized Context="auth">
                    <span class="user-email">@auth.User.FindFirst(ClaimTypes.Email)?.Value</span>
                </Authorized>
            </AuthorizeView>

            <a href="#" class="button">+ Dodaj ogłoszenie</a>
        </div>
    </div>
</nav>